{
  "extends": "./tsconfig.app.vitest.json",
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.app.vitest.browser.tsbuildinfo"
    // `types` is inherited from the app as ["vite/client"]. No "node": these
    // specs run in a real browser, where Node's globals do not exist.
  },
  "include": [
    "src/**/*.browser.test.ts",
    "src/**/*.browser.test.tsx",
    "src/**/*.browser.spec.ts",
    "src/**/*.browser.spec.tsx"
  ]
}
