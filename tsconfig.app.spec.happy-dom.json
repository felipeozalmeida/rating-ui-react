{
  "extends": "./tsconfig.app.spec.json",
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.app.spec.happy-dom.tsbuildinfo",
    // Replaces rather than merges, so every entry must be restated. Where two
    // entries declare the same ambient symbol the first one wins, which is why
    // an override goes before what it overrides:
    // https://vite.dev/guide/features.html#client-types
    "types": ["vite/client", "node"]
  },
  "include": [
    "src/tests/env.happy-dom.d.ts",
    "src/tests/env.dom.setup.ts",
    // `.dom.` specs run on the default DOM implementation, which is this one
    "src/**/*.dom.test.ts",
    "src/**/*.dom.test.tsx",
    "src/**/*.dom.spec.ts",
    "src/**/*.dom.spec.tsx",
    "src/**/*.happy-dom.test.ts",
    "src/**/*.happy-dom.test.tsx",
    "src/**/*.happy-dom.spec.ts",
    "src/**/*.happy-dom.spec.tsx"
  ]
}
