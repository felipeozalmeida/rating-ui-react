{
  "extends": "./tsconfig.app.vitest.json",
  "files": [],
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.app.vitest.node.tsbuildinfo",
    // Drops DOM so an unqualified spec cannot reach for `document` — that is a
    // compile error telling you to qualify the filename. `lib` replaces rather
    // than merges, so this restates the ES level from tsconfig.app.json and
    // will drift if @tsconfig/bases/vite-react moves past ES2023.
    "lib": ["ES2023"],
    "types": ["vite/client", "node"]
  },
  "include": ["src/**/*.test.ts", "src/**/*.spec.ts"],
  "exclude": ["src/**/*.jsdom.test.ts", "src/**/*.jsdom.spec.ts"]
}
